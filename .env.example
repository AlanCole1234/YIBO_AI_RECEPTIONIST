# Local trusted access context. In production this comes from authentication/session claims.
YIBO_REGION=MX
YIBO_TENANT_ID=tenant-yibo-demo

# Conversation runtime. API and admin keys are different secrets.
YIBO_RUNTIME=in-memory
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Google Calendar integration. Keep these values only in .env, never Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=
# Generate locally with: openssl rand -hex 32
YIBO_TOKEN_ENCRYPTION_KEY=

# Private Asterisk ARI control. Keep these only in .env; ARI must be reachable
# only across Tailscale/VPN, never the public internet.
ASTERISK_ARI_URL=http://100.106.32.65:8088
ASTERISK_ARI_APPLICATION=yibo
ASTERISK_ARI_USERNAME=yibo
ASTERISK_ARI_PASSWORD=
YIBO_ASTERISK_MEDIA_HOST=100.99.195.117
YIBO_ASTERISK_MEDIA_PORT_START=40000
YIBO_ASTERISK_MEDIA_PORT_END=40020
# Development-only private Linphone diagnostic. This is ignored when NODE_ENV=production
# and only applies to the exact Stasis() dialed-number argument you specify.
# YIBO_ASTERISK_PRIVATE_TEST_DISABLE_BARGE_IN_FOR_DIALED_NUMBER=+529991000000
# Private 7001 A/B telephone diagnostic only; ignored in production. Use one
# source at a time: pcmu_tone bypasses Realtime/resampling; realtime_tone uses
# the exact 24 kHz -> PCMU conversion path without OpenAI.
# YIBO_ASTERISK_AUDIO_DIAGNOSTIC_DIALED_NUMBER=7001
# YIBO_ASTERISK_AUDIO_DIAGNOSTIC_SOURCE=pcmu_tone

# Optional custom database locations. Defaults are data/yibo-mx.sqlite and data/yibo-us.sqlite.
# YIBO_DATABASE_MX=D:/path/to/yibo-mx.sqlite
# YIBO_DATABASE_US=D:/path/to/yibo-us.sqlite
