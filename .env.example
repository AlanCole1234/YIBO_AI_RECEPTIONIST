# Local trusted access context. In production this comes from authentication/session claims.
YIBO_REGION=MX
YIBO_TENANT_ID=tenant-yibo-demo

# Local Developer Test Mode is disabled by default. Set to 1 only while testing
# through the local voice harness; it is never enabled for normal API sessions.
# YIBO_LOCAL_DEVELOPER_TEST_MODE=1

# Conversation runtime. API and admin keys are different secrets.
YIBO_RUNTIME=in-memory
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Google Calendar integration. Keep these values only in .env, never Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=
# Generate locally with: openssl rand -hex 32
YIBO_TOKEN_ENCRYPTION_KEY=

# Optional custom database locations. Defaults are data/yibo-mx.sqlite and data/yibo-us.sqlite.
# YIBO_DATABASE_MX=D:/path/to/yibo-mx.sqlite
# YIBO_DATABASE_US=D:/path/to/yibo-us.sqlite
