# /etc/yibo/backup.env, root:root 0600. Reuse deploy/backup units and run-backup.sh.
YIBO_BACKUP_ROOT=/var/lib/yibo-backups
YIBO_BACKUP_REGIONS=US
YIBO_DATABASE_US=/var/lib/yibo/staging-us.sqlite
YIBO_RELEASE_SHA=REPLACE_WITH_EXACT_40_CHARACTER_STAGING_RELEASE_SHA
RESTIC_REPOSITORY_FILE=/etc/yibo/restic-repository
RESTIC_PASSWORD_FILE=/etc/yibo/restic-password
RESTIC_CACHE_DIR=/var/cache/yibo-restic
AWS_DEFAULT_REGION=us-east-2

# Proposed: private Lightsail bucket with resource access for this staging host only.
# No AWS access keys. Verify restic's instance-metadata authentication on the host
# before enabling the timer. Never relax IMDSv2 or bucket privacy to make it work.
# Repository file: s3:https://s3.us-east-2.amazonaws.com/<approved-bucket>/yibo-staging
# Repository/password files: root:yibo-api 0640 under /etc/yibo (root:yibo-api 0750).
# Keep the restic password separately in the owner's vault for disaster recovery.
