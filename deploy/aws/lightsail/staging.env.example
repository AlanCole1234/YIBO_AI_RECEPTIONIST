# SYNTHETIC STAGING ONLY. Private operator-created /etc/yibo/backend.env, root:root 0600.
# Used with the existing deploy/node/yibo-api.service.example and staging drop-in.
# No values from the working phone .env or a production database belong here.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DOTENV_CONFIG_PATH=/dev/null
YIBO_RUNTIME=in-memory
YIBO_TENANT_ID=tenant-yibo-demo-us
YIBO_REGION=US
YIBO_DATABASE_US=/var/lib/yibo/staging-us.sqlite
YIBO_INSTANCE_LOCK=1
YIBO_INSTANCE_LOCK_PATH=/var/lib/yibo/staging-instance.lock
YIBO_CALL_RECORDING=off
YIBO_OUTBOUND_DIALING=off

# Generate privately on the approved staging host; minimum 32 random bytes.
YIBO_ADMIN_SESSION_KEY=

# Public hostname/origin come from /etc/yibo/public.env, shared with Caddy.
# Deliberately omit Google, OpenAI, ARI, RTP, Telnyx, email and AWS access keys.
