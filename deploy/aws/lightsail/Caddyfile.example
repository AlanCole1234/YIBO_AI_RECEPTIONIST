# SYNTHETIC STAGING ONLY. No certificate is requested by caddy adapt/validate.
# Use Caddy 2.11.7; this explicitly selects public IP certificate support.
# Start only after approval for the assigned static IP and ACME registration.
{
	# IP-address clients omit SNI. Select this site's managed certificate even
	# behind Lightsail's public-to-private address translation.
	default_sni {$YIBO_PUBLIC_HOSTNAME:yibo.invalid}
	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory {
		profile shortlived
	}
}

# Keep dashboard/API/private-route behavior in the already tested AWS template.
# The service reads this file in the immutable release, preserving relative import.
import ../Caddyfile.example
