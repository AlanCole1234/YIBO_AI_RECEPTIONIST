# /etc/yibo/public.env, root:root 0644. Nonsecret, but writable only by root.
# Replace BOTH values with the assigned, approved Lightsail static public IPv4.
# An owned DNS hostname is also supported if DNS changes are separately approved.
# No domain purchase is needed for the initial IP-certificate staging test.
# This reserved placeholder deliberately fails the staging startup check.
YIBO_PUBLIC_HOSTNAME=staging.yibo.invalid
YIBO_DASHBOARD_ORIGIN=https://staging.yibo.invalid
