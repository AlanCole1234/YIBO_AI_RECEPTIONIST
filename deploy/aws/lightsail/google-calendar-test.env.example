# PREPARED ONLY: requires separate staging activation approval.
# Review docs/AWS_STAGING_GOOGLE_ACCEPTANCE.md before installing any values.
# Private /etc/yibo/backend.env, root:root 0600. Never commit the completed file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DOTENV_CONFIG_PATH=/dev/null
YIBO_RUNTIME=in-memory
YIBO_STAGING_PROVIDER=google-calendar-test
YIBO_TENANT_ID=tenant-yibo-demo-us
YIBO_REGION=US
YIBO_DATABASE_US=/var/lib/yibo/staging-google-us.sqlite
YIBO_INSTANCE_LOCK=1
# Keep the same host lock: synthetic and Google-test APIs must never overlap.
YIBO_INSTANCE_LOCK_PATH=/var/lib/yibo/staging-instance.lock
YIBO_CALL_RECORDING=off
YIBO_OUTBOUND_DIALING=off

# Preserve the existing private staging session key; never copy it into Git.
YIBO_ADMIN_SESSION_KEY=
# Separate test-project web client. Secret entered privately on staging.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.getyibo.com/api/integrations/google/callback
# Exact secondary-calendar ID copied from the verified test-only account.
# "primary" and personal-account calendar IDs are intentionally rejected.
GOOGLE_CALENDAR_ID=
# Generate privately on staging: 32 random bytes represented by 64 hex characters.
# Distinct from the session key, live token key and restic recovery password.
YIBO_TOKEN_ENCRYPTION_KEY=

# Keep existing /etc/yibo/public.env and Caddy unchanged.
# Never add OpenAI, ARI/RTP, Telnyx, email or AWS credentials to this file.
