{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yibo-dashboard",
  "main": "deploy/cloudflare/worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
